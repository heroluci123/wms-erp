PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Segredo JWT (troque em producao por uma string aleatoria forte de >= 32 caracteres)
JWT_SECRET=wmsphere-dev-secret-trocar-em-producao-2026

# Driver do PostgreSQL:
# - 'pglite' para testes locais sem instalar PostgreSQL (salva em server/data/pgdata ou memoria)
# - 'pg' para Neon / Supabase / PostgreSQL real
PG_DRIVER=pglite
PGLITE_DATA_DIR=./data/pgdata

# URL do PostgreSQL gerenciado (Neon / Supabase) quando PG_DRIVER=pg
DATABASE_URL=

# Origens permitidas no CORS (separadas por virgula)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Opcional: usado apenas no script unico de migracao (npm run db:migrate-turso)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
